{
    "name": "webmcp-poc",
    "version": "1.0.0",
    "scripts": {
        "start": "catalyst start",
        "build": "npm run typecheck && catalyst build",
        "serve": "catalyst serve",
        "lint": "eslint .",
        "buildApp": "catalyst buildApp",
        "buildApp:ios": "catalyst buildApp:ios",
        "buildApp:android": "catalyst buildApp:android",
        "setupEmulator": "catalyst setupEmulator",
        "setupEmulator:ios": "catalyst setupEmulator:ios",
        "setupEmulator:android": "catalyst setupEmulator:android",
        "typecheck": "tsc --noEmit",
        "sync-core": "node ../sync-core.js",
        "sync-packages": "node ../sync-packages.js --packages"
    },
    "_moduleAliases": {
        "@api": "api.js",
        "@containers": "src/js/containers",
        "@server": "server",
        "@config": "config",
        "@css": "src/static/css",
        "@routes": "src/js/routes/",
        "@store": "src/js/store/index.js",
        "@webmcp": "src/js/webmcp/",
        "@pages": "src/js/pages/"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.9.0",
        "@tailwindcss/postcss": "^4.1.4",
        "catalyst-core": "0.3.0-canary.1",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-redux": "^9.2.0",
        "react-router": "^7.18.2",
        "redux": "^5.0.1",
        "tailwindcss": "^4.1.4"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^8.26.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "typescript": "^5.8.3"
    },
    "overrides": {
        "react-helmet-async": {
            "react": "^16.6.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
            "react-dom": "^16.6.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
        }
    },
    "description": "webmcppoc"
}
