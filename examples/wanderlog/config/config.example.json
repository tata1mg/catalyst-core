{
    "NODE_SERVER_HOSTNAME": "0.0.0.0",
    "NODE_SERVER_PORT": 3005,
    "WEBPACK_DEV_SERVER_HOSTNAME": "0.0.0.0",
    "WEBPACK_DEV_SERVER_PORT": 3006,
    "BUILD_OUTPUT_PATH": "build",
    "PUBLIC_STATIC_ASSET_PATH": "/assets/",
    "PUBLIC_STATIC_ASSET_URL": "http://YOUR_LAN_IP:3005",
    "API_URL": "",
    "ANALYZE_BUNDLE": false,
    "CLIENT_ENV_VARIABLES": ["API_URL"],
    "WEBVIEW_CONFIG": {
        "LOCAL_IP": "YOUR_LAN_IP",
        "port": "3005",
        "appInfo": "wanderlog-v1",
        "android": {
            "buildType": "debug",
            "sdkPath": "/path/to/Android/sdk",
            "emulatorName": "android",
            "cachePattern": "*.css"
        },
        "ios": {
            "buildType": "debug"
        },
        "initial_url": "",
        "useHttps": false,
        "edgeToEdge": {
            "enabled": true
        },
        "accessControl": {
            "enabled": false,
            "allowedUrls": []
        },
        "notifications": {
            "enabled": true
        },
        "profiler": {
            "enabled": false
        }
    }
}
