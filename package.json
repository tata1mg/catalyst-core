{
    "name": "catalyst-monorepo",
    "private": true,
    "engines": {
        "node": ">=22.22.2"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "setup": "node scripts/setup.js",
        "sandbox:create": "node scripts/create-release-sandbox.js",
        "core:build": "npm run prepare --workspace packages/catalyst-core",
        "core:test": "sh ./scripts/test-catalyst-core.sh",
        "cca:test": "sh ./scripts/test-cca-smoke.sh",
        "cca:sync-templates": "node scripts/release/sync-cca-templates.js",
        "docs:build": "npm --prefix docs run build",
        "docs:start": "npm --prefix docs run start",
        "test:example": "sh ./scripts/test-all.sh",
        "test:unit": "npm run test --workspaces --if-present && npm --prefix packages/catalyst-core/mcp_v2 test",
        "lint": "npm run lint --workspaces --if-present",
        "lint:oxlint": "oxlint . --quiet",
        "lint-staged": "lint-staged"
    },
    "devDependencies": {
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "oxlint": "1.79.0"
    },
    "overrides": {
        "uuid": "11.1.1",
        "file-type": "22.0.1",
        "imagemin": "9.0.1"
    }
}
