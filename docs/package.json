{
    "name": "@catalyst/docs",
    "version": "1.0.0",
    "description": "Catalyst documentation site",
    "scripts": {
        "docs:generate": "node scripts/generate-docs-manifest.mjs",
        "docs:check-links": "node scripts/check-docs-links.mjs",
        "prestart": "npm run docs:generate",
        "prebuild": "npm run docs:generate",
        "start": "catalyst start",
        "build": "catalyst build",
        "serve": "catalyst serve",
        "lint": "eslint .",
        "sync-core": "node ../examples/sync-core.js"
    },
    "_moduleAliases": {
        "@api": "api.js",
        "@containers": "src/js/containers",
        "@server": "server",
        "@config": "config",
        "@css": "src/static/css",
        "@routes": "src/js/routes/",
        "catalyst-core/PluginBridge": "node_modules/catalyst-core/dist/native/plugin-bridge/PluginBridge.js"
    },
    "dependencies": {
        "@mdx-js/react": "^3.1.1",
        "catalyst-ai": "^0.1.1",
        "catalyst-core": "1.0.3-canary.1",
        "prism-react-renderer": "^2.4.1",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@mdx-js/mdx": "^3.1.1",
        "eslint": "^8.26.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "github-slugger": "^2.0.0",
        "gray-matter": "^4.0.3",
        "rehype-slug": "^6.0.0",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "unist-util-visit": "^5.1.0"
    },
    "overrides": {
        "react-helmet-async": {
            "react": "^16.6.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
            "react-dom": "^16.6.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
        },
        "esbuild": "0.28.2"
    }
}
