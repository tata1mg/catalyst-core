{
    /*
     * Type-checking only. Emission is owned by scripts/build-dist.mjs, which
     * strips types with @babel/preset-typescript and leaves module syntax and
     * JSX exactly as authored. Declaration (.d.ts) output is a later migration
     * step and is deliberately not wired up here.
     */
    "compilerOptions": {
        /* Language and Environment */
        "target": "es2022",
        "lib": ["es2022", "dom", "dom.iterable"],
        /* dist ships raw .jsx and the runtime (vite / dist/vite/node-loader.mjs)
           transforms it, so JSX must survive checking untransformed. */
        "jsx": "preserve",

        /* Modules — ESM source consumed by a bundler-style resolver, which is
           what lets ./foo.jsx specifiers resolve to foo.tsx on disk. */
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,

        /* JavaScript Support — the tree is still mostly .js/.jsx during the
           migration, so those files must resolve but not be checked. */
        "allowJs": true,
        "checkJs": false,

        /* Emit — tsc never writes anything; build-dist.mjs does. */
        "noEmit": true,

        /* Interop Constraints */
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,

        /* Type Checking — deliberately loose for the migration. Tightening is
           a later step, once the tree is fully converted. */
        "strict": false,

        /* Completeness */
        "skipLibCheck": true
    },
    "include": ["src"]
}
